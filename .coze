[project]
sub_id = "d9cc33f6"
name = "ziway-backend"
requires = ["golang-1.25"]
project_type = "backend"
version = "0.0.35"
entrypoint = "ziway-backend/cmd/ms/main.go"

[preview]
preview_enable = "disabled"

[deploy]
build = ["bash", "ziway-backend/scripts/build.sh"]
run = ["bash", "ziway-backend/scripts/run.sh", "-p", "5000"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["ziway-backend"]
