[project]
sub_id = "d9cc33f6"
name = "ziway-backend"
project_type = "web"
version = "0.0.35"
entrypoint = "ziway-backend/cmd/oas/main.go"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "ziway-backend/scripts/build.sh"]
run = ["bash", "ziway-backend/scripts/run.sh", "-p", "5000"]

[deploy]
build = ["bash", "ziway-backend/scripts/build.sh"]
run = ["bash", "ziway-backend/scripts/run.sh", "-p", "5000"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["ziway-backend"]
