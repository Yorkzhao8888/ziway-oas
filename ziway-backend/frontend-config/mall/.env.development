# ============================================
# ziway-Mall 环境变量 — 开发环境
# BOS: cbos → cmbs(客户) + dmbs(经营)  [ZW-ARC-017]
# ============================================

# 开发环境 BOS 地址
VITE_BOS_BASE_URL=http://localhost:8082

# ---- BOS 代理基址（拼接在 VITE_BOS_BASE_URL 后面）----
VITE_CMBS_BASE=/api/v1/bos/cbos/proxy/cmbs
VITE_DMBS_BASE=/api/v1/bos/cbos/proxy/dmbs

# ---- OAS 直连（登录/鉴权走 abos）----
VITE_AMBS_BASE=/api/v1/bos/abos/proxy/ambs

# ---- APP 元信息 ----
VITE_APP_NAME=ziway-Mall
VITE_APP_BOS=cbos
