# ============================================
# ziway-Shop 环境变量 — 开发环境
# BOS: dbos → dmbs(经营) + hmbs(人力) + fmbs(财务)  [ZW-ARC-017]
# ============================================

VITE_BOS_BASE_URL=http://localhost:8082

# 经营模块（门店/KPI/GP）
VITE_DMBS_BASE=/api/v1/bos/dbos/proxy/dmbs
# 人力模块（组织/员工/考勤/请假）
VITE_HMBS_BASE=/api/v1/bos/dbos/proxy/hmbs
# 财务模块（总账/收支/发票/GP分润）
VITE_FMBS_BASE=/api/v1/bos/dbos/proxy/fmbs

VITE_AMBS_BASE=/api/v1/bos/abos/proxy/ambs

VITE_APP_NAME=ziway-Shop
VITE_APP_BOS=dbos
