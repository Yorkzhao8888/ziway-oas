# ============================================
# ziway-Xcase 环境变量 — 生产环境
# 复合APP：投资Tab(ibos) + 运营Tab(vbos) + 治理Tab(obos) + 运维Tab(abos)
# BOS: ibos→imbs+fmbs | vbos→gmbs+ombs+vmbs | obos→ombs | abos→ambs  [ZW-ARC-017]
# ============================================

VITE_BOS_BASE_URL=https://bos.zhiwei.com

# ---- 投资 Tab (ibos) ----
VITE_IMBS_BASE=/api/v1/bos/ibos/proxy/imbs
VITE_FMBS_IBOS_BASE=/api/v1/bos/ibos/proxy/fmbs

# ---- 运营 Tab (vbos) ----
VITE_VMBS_BASE=/api/v1/bos/vbos/proxy/vmbs
VITE_OMBS_VBOS_BASE=/api/v1/bos/vbos/proxy/ombs
VITE_GMBS_VBOS_BASE=/api/v1/bos/vbos/proxy/gmbs

# ---- 治理 Tab (obos) [ZW-ARC-017 新增] ----
VITE_OMBS_OBOS_BASE=/api/v1/bos/obos/proxy/ombs

# ---- 运维 Tab (abos) ----
VITE_AMBS_BASE=/api/v1/bos/abos/proxy/ambs

VITE_APP_NAME=ziway-Xcase
VITE_APP_BOS=ibos,vbos,obos,abos
